{
  "name": "@hnjobs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "db:migrate": "wrangler d1 execute hnjobs-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute hnjobs-db --remote --file=schema.sql",
    "db:migrate:listing-month": "node scripts/migrate-listing-month.mjs --local",
    "db:migrate:listing-month:remote": "node scripts/migrate-listing-month.mjs --remote"
  },
  "dependencies": {
    "@hnjobs/core": "workspace:*",
    "@hono/trpc-server": "^0.4.1",
    "@trpc/server": "^11.8.1",
    "hono": "^4.11.3",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260103.0",
    "wrangler": "^4.54.0"
  }
}
